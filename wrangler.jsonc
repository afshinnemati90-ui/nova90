{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova90",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "19706cd2-a28b-4847-bc51-113c233bb29e","database_name": "nova90" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "06b5b1b660ec4cc8ac88da21716f522e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
